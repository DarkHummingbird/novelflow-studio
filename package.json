{
  "name": "novelflow-studio",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "续章工坊 · 上传小说录屏并续写",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=data/admin.local.env scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run build",
    "smoke:commerce": "node scripts/smoke-commerce.mjs",
    "smoke:models": "node scripts/smoke-models.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
